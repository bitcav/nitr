<!-- Theme toggle before login: the panel's toggle is behind auth, so without
     this the login screen could only follow the OS preference and offered no
     way to change it. #themeToggle is the same id panel.js already binds, and
     panel.js is loaded on every page by the layout, so no extra script is
     needed here. -->
<button id="themeToggle" type="button"
  class="uk-button uk-button-default uk-button-small theme-toggle-floating"
  uk-tooltip="title: Toggle dark/light theme; pos: left" aria-label="Toggle dark or light theme">
  <svg class="theme-icon theme-icon-moon" width="16" height="16" viewBox="0 0 20 20" aria-hidden="true">
    <path d="M17 12.2A7.5 7.5 0 0 1 7.8 3 7.5 7.5 0 1 0 17 12.2z"
      fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  </svg>
  <svg class="theme-icon theme-icon-sun" width="16" height="16" viewBox="0 0 20 20" aria-hidden="true">
    <circle cx="10" cy="10" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6"/>
    <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <path d="M10 1.4v2.2M10 16.4v2.2M1.4 10h2.2M16.4 10h2.2"/>
      <path d="M3.9 3.9l1.6 1.6M14.5 14.5l1.6 1.6M16.1 3.9l-1.6 1.6M5.5 14.5l-1.6 1.6"/>
    </g>
  </svg>
</button>
<div class="uk-section uk-section-muted uk-flex uk-flex-middle uk-animation-fade" uk-height-viewport>
  <div class="uk-width-1-1">
    <div class="uk-container">
      <div class="uk-grid-margin uk-grid uk-grid-stack" uk-grid>
        <div class="uk-width-1-1@m">
          <div class="uk-margin uk-width-large uk-margin-auto uk-card uk-card-default uk-card-body uk-box-shadow-large">
            <img alt="nitr logo" src="/assets/images/logo.png" width="180" class="uk-margin-bottom uk-align-center ">
            <form action="/" method="POST">
              <div class="uk-margin">
              </div>
              <div class="uk-margin">
                <div class="uk-inline uk-width-1-1">
                  <span class="uk-form-icon" uk-icon="icon: lock"></span>
                  <input class="uk-input uk-form-large" type="password" name="password" placeholder="password" autofocus required>
                </div>
              </div>
              <div class="uk-margin">
                <button class="uk-button uk-button-primary uk-button-large uk-width-1-1">Login</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>